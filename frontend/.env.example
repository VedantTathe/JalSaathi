# Copy this file to .env (or set the variables in your hosting/CI) and fill values.
# WARNING: Any variable here is embedded into the built frontend and is public.
# Do NOT put secrets (API secret keys, payment secret keys) in these variables.

# API
VITE_APP_API_URL=http://localhost:5000/api
VITE_APP_API_BASE_URL=https://api.example.com/api

# App metadata
VITE_APP_APP_NAME=JalSaathi
VITE_APP_VERSION=1.0.0

# Google Maps (restrict this key by HTTP referrers in Google Cloud Console)
VITE_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Notes:
# - Vite requires the `VITE_` prefix; access in code via `import.meta.env.VITE_APP_API_BASE_URL`.
# - These vars are build-time only. To keep secrets private, create the value on your backend
#   and let the backend call external services (e.g., Cashfree secret keys must stay server-side).
# - For AWS Amplify: set these under App settings → Environment variables (they'll be used at build).
# - For S3/CloudFront or custom CI: set env values in your CI (GitHub Actions, etc.) before `npm run build`.
