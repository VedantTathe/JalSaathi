# MongoDB Connection String
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/JalSaathiDB?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=JalSaathi <your-email@gmail.com>
ADMIN_EMAIL=admin@jalsaathi.com

# Cashfree Payment Gateway
CASHFREE_APP_ID=your-app-id
CASHFREE_SECRET_KEY=your-secret-key
CASHFREE_ENV=production

# Frontend & Backend URLs
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net
BACKEND_URL=https://your-api-gateway-url.execute-api.ap-south-1.amazonaws.com/prod
CASHFREE_RETURN_URL=https://your-cloudfront-domain.cloudfront.net/dashboard/
CASHFREE_WEBHOOK_URL=https://your-api-gateway-url.execute-api.ap-south-1.amazonaws.com/prod/api/webhook/cashfree

# Deployment Settings
JWT_EXPIRES_IN=7d
PLATFORM_COMMISSION_PERCENT=1.5
IS_WEBSITE_ON=true
