{
  "version": 2,
  "installCommand": "cd ../frontend && npm install --include=dev",
  "buildCommand": "npm run build --prefix ../frontend && mkdir -p public && cp -r ../frontend/dist/* public/",
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
